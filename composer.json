{
    "name": "lowseekai/oauth-connect",
    "description": "OAuth2 provider for Flarum forums.",
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/lowseekai/oauth-connect",
    "support": {
        "issues": "https://github.com/lowseekai/oauth-connect/issues",
        "source": "https://github.com/lowseekai/oauth-connect"
    },
    "require": {
        "flarum/core": "^2.0.0-rc.8",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "Lowseekai\\OAuthConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lowseekai\\OAuthConnect\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "extra": {
        "flarum-extension": {
            "title": "OAuth Connect",
            "category": "feature",
            "icon": {
                "name": "fas fa-key",
                "backgroundColor": "#2563eb",
                "color": "#ffffff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
